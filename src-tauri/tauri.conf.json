{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AssessIT",
  "version": "0.1.7",
  "identifier": "io.github.zaclohrenz.assessit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AssessIT",
        "width": 1240,
        "height": 880,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Software risk assessment",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5QTc4N0YzMTZCN0FBRjMKUldUenFyY1c4NGVubVYxZGtsWHVzL1ErQ3crNHNMTVoyeC9DM0Q1Qkp5U0RRLytXYmNtWlZIZFYK",
      "endpoints": [
        "https://github.com/zaclohrenz/AssessIT/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
